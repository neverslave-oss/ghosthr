{
  "name": "ghosthr",
  "version": "0.1.0",
  "private": true,
  "description": "ghostHR — Chromium extension to help candidates decide whether to apply and track applications (standalone-first).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test tests/e2e"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.27",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
