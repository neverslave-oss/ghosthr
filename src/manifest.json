{
  "manifest_version": 3,
  "name": "ghostHR",
  "version": "0.1.0",
  "description": "Decide whether a job is worth applying to, get hold-back prep, and track applications — standalone-first.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ghostHR"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
